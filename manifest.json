{
  "manifest_version": 3,
  "name": "Turndown Service",
  "version": "0.9.0",
  "description": "Darkens sites with no dark mode (Docs, Sheets, Slides, Apps Script, Play Console, App Store Connect, Okta) and white parts of Gmail.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*",
        "https://docs.google.com/presentation/u/*"
      ],
      "exclude_matches": ["https://docs.google.com/presentation/u/*/d/*"],
      "css": ["dark.css"],
      "js": ["docs-canvas.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.okta.com/*",
        "https://play.google.com/console/*",
        "https://appstoreconnect.apple.com/*",
        "https://script.google.com/home*",
        "https://script.google.com/u/*/home*"
      ],
      "css": ["dark.css"]
    },
    {
      "matches": ["https://mail.google.com/*"],
      "css": ["gmail.css"]
    },
    {
      "matches": ["https://docs.google.com/picker/*"],
      "js": ["docs-picker.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
