{
  "manifest_version": 3,
  "name": "Turndown Service",
  "version": "0.8.0",
  "description": "Darkens work sites with no dark mode (Google Docs, Sheets, Slides, Play Console, App Store Connect, Okta) and white parts of Gmail.",
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*",
        "https://docs.google.com/presentation/u/*"
      ],
      "exclude_matches": ["https://docs.google.com/presentation/u/*/d/*"],
      "css": ["dark.css"],
      "js": ["docs-canvas.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.okta.com/*",
        "https://play.google.com/console/*",
        "https://appstoreconnect.apple.com/*"
      ],
      "css": ["dark.css"]
    },
    {
      "matches": ["https://mail.google.com/*"],
      "css": ["gmail.css"]
    },
    {
      "matches": ["https://docs.google.com/picker/*"],
      "js": ["docs-picker.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
