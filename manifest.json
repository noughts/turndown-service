{
  "manifest_version": 3,
  "name": "Turndown Service",
  "version": "0.7.0",
  "description": "Google Docs・Google スプレッドシート・Google スライドのファイル一覧・Google Play Console・Okta をダークモードで表示し、Gmail の読み込み画面とメールを開いた画面を暗くする",
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*",
        "https://docs.google.com/presentation/u/*"
      ],
      "exclude_matches": ["https://docs.google.com/presentation/u/*/d/*"],
      "css": ["dark.css"],
      "js": ["docs-canvas.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.okta.com/*", "https://play.google.com/console/*"],
      "css": ["dark.css"]
    },
    {
      "matches": ["https://mail.google.com/*"],
      "css": ["gmail.css"]
    },
    {
      "matches": ["https://docs.google.com/picker/*"],
      "js": ["docs-picker.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
